# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# IDE and AI assistant folders
.bmad
.claude
.vscode
.windsurf

# Screenshots and recordings
screenshot/

# Data storage (intakes, etc.)
/data

# Service account keys (NEVER commit these)
service-account.json
*-service-account.json
*.keyfile.json
scripts/content-pipeline/venv/
__pycache__/
*.pyc
public/generated/*.raw.mp4
